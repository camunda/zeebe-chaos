{
    "version": "0.1.0",
    "title": "Coordinated leadership rebalance under load",
    "description": "Leadership that drifted off the highest-priority replicas can be rebalanced back, one partition at a time, while the cluster keeps processing.",
    "contributions": {
        "reliability": "high",
        "availability": "high"
    },
    "steady-state-hypothesis": {
        "title": "Zeebe is alive",
        "probes": [
            {
                "name": "All pods should be ready",
                "type": "probe",
                "tolerance": 0,
                "provider": {
                    "type": "process",
                    "path": "zbchaos",
                    "arguments": [
                        "verify",
                        "readiness"
                    ],
                    "timeout": 900
                }
            },
            {
                "name": "Should be able to create a process instance",
                "type": "probe",
                "tolerance": 0,
                "provider": {
                    "type": "process",
                    "path": "zbchaos",
                    "arguments": [
                        "verify",
                        "instance-creation",
                        "--awaitResult"
                    ],
                    "timeout": 900
                }
            }
        ]
    },
    "method": [
        {
            "name": "Deploy process model",
            "type": "action",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "deploy",
                    "process"
                ]
            }
        },
        {
            "name": "Deploy workers, so that the instances started below complete",
            "type": "action",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "deploy",
                    "worker"
                ]
            }
        },
        {
            "name": "Restart the leader of partition one, so a lower-priority replica takes over",
            "type": "action",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "restart",
                    "broker",
                    "--role",
                    "LEADER",
                    "--partitionId",
                    "1"
                ],
                "timeout": 900
            }
        },
        {
            "name": "Restart the leader of partition three, so a second partition drifts too",
            "type": "action",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "restart",
                    "broker",
                    "--role",
                    "LEADER",
                    "--partitionId",
                    "3"
                ],
                "timeout": 900
            }
        },
        {
            "name": "All pods should be ready again before rebalancing",
            "type": "probe",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "verify",
                    "readiness"
                ],
                "timeout": 900
            }
        },
        {
            "name": "Leadership should have drifted off the highest-priority replicas",
            "type": "probe",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "verify",
                    "leadership",
                    "--expectUnbalanced",
                    "--timeoutInSec",
                    "120"
                ],
                "timeout": 300
            }
        },
        {
            "name": "Start instances the rebalance has to carry, so a transfer has writes to pause",
            "type": "action",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "verify",
                    "instance-count",
                    "--instanceCount",
                    "100",
                    "--timeoutInSec",
                    "120"
                ],
                "timeout": 300
            }
        },
        {
            "name": "Rebalance leadership back towards the highest-priority replicas",
            "type": "action",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "cluster",
                    "rebalance",
                    "--timeoutInSec",
                    "300"
                ],
                "timeout": 600
            }
        },
        {
            "name": "Every partition should be led by its highest-priority replica",
            "type": "probe",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "verify",
                    "leadership",
                    "--timeoutInSec",
                    "120"
                ],
                "timeout": 300
            }
        },
        {
            "name": "Instances started through the rebalance should still complete",
            "type": "probe",
            "tolerance": 0,
            "provider": {
                "type": "process",
                "path": "zbchaos",
                "arguments": [
                    "verify",
                    "instance-creation",
                    "--awaitResult"
                ],
                "timeout": 900
            }
        }
    ],
    "rollbacks": []
}
